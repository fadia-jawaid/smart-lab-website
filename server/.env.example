PORT=5000
NODE_ENV=development

# Database — Local SQLite (Zero configuration needed)
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=smart_lab_tracker_secure_local_jwt_secret_key_32chars_min
JWT_EXPIRES_IN=7d

# MQTT Broker (Embedded Broker on port 1883)
MQTT_BROKER=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=

# Optional security key for ESP32 HTTP requests. Leave blank for local testing.
ESP32_API_KEY=

# Frontend Origin
CLIENT_URL=http://localhost:5173

# Alert Thresholds
ALERT_OVERDUE_MINUTES=30
ALERT_LOW_STOCK_PCT=20
ALERT_LEAKAGE_GRAMS=50

# Gmail SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartLab <noreply@smartlab.com>