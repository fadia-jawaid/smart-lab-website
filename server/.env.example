# ─── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────
# Replace YOUR_PASSWORD with the password you set for lab_user in PostgreSQL
DATABASE_URL="postgresql://lab_user:YOUR_PASSWORD@localhost:5432/smart_lab"

# ─── Authentication ───────────────────────────────────────────────
# Must be at least 32 characters — use a random string
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── MQTT Broker ──────────────────────────────────────────────────
MQTT_BROKER=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=

# ─── Frontend Origin ──────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Alert Thresholds ─────────────────────────────────────────────
ALERT_OVERDUE_MINUTES=30
ALERT_LOW_STOCK_PCT=20
ALERT_LEAKAGE_GRAMS=50

# ─── Optional: AI Analytics Microservice ──────────────────────────
# ANALYTICS_URL=http://localhost:8000